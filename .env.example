# Copy to .env and fill in. Multi-value fields are split on '||' so that Windows
# paths containing spaces survive.

# --- Hevy MCP (stdio) ---
# The server that holds your Hevy API key. This app never sees the key itself.
HEVY_MCP_COMMAND=/path/to/hevy-mcp
HEVY_MCP_ARGS=
HEVY_MCP_ENV=HEVY_DOTENV=/path/to/hevy-mcp/.env

# --- Google Health MCP (stdio) ---
HEALTH_MCP_COMMAND=node
HEALTH_MCP_ARGS=/path/to/google-health-mcp-server/dist/index.js
HEALTH_MCP_ENV=GOOGLE_HEALTH_TOKEN_PATH=/path/to/token.json

# --- conventions ---
# Weighting applied to sets where a muscle is a secondary mover.
SECONDARY_WEIGHT=0.5
# Whether warmup sets count toward effective volume. Standard practice is no.
COUNT_WARMUP_SETS=false
# Your UTC offset in minutes; decides which day a late-evening session lands on.
LOCAL_UTC_OFFSET_MINUTES=0
# 0 = weeks start Monday.
WEEK_STARTS_ON=0
# Default double-progression rep range; override per exercise via the API.
REP_RANGE_LOW=6
REP_RANGE_HIGH=10

# --- model layer (optional; only `ledger ask` and the chat dock need it) ---
# Leave LLM_PROVIDER blank to use whichever key is set, preferring the free one.
# Options: gemini | anthropic | ollama | openai-compatible
LLM_PROVIDER=gemini

# Gemini: free key, no card, at https://aistudio.google.com/apikey
# Note: outside the EEA/UK/Switzerland the free tier's terms allow Google to use
# prompts for product improvement, with human review. Your questions carry
# training data, so choose the tier knowingly.
GEMINI_API_KEY=
# gemini-2.5-flash returns 404 -- "no longer available to new users" -- on keys
# issued recently, so do not copy it from an older README. Of the free models
# tested against the coach: 3.5-flash-lite plans badly (four sets for a week
# with eleven muscle groups short), 3.5-flash plans well on 20 requests a day,
# and 3.6-flash plans well and is the default.
GEMINI_MODEL=gemini-3.6-flash

# Reasoning models spend the token budget thinking before they write, which
# truncates answers mid-sentence. Gemini defaults to `none` here because this
# app forbids the model from reasoning about numbers anyway. Set low/medium/high
# to re-enable, or `off` to send no parameter at all.
# LLM_REASONING_EFFORT=none

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Local models: `ollama pull qwen3:4b`, then LLM_PROVIDER=ollama. Nothing leaves
# the machine. Pick a model with tool support -- gemma3 has none in Ollama, so
# the tool loop cannot run on it.
# LLM_MODEL=qwen3:4b

# Any other /chat/completions server (DeepSeek, OpenRouter, Groq, vLLM).
# One switch moves both the chat dock and the coach. The dock needed no code
# for this; the coach reaches non-Gemini models through LiteLLM, which the
# [coach] extra installs.
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=
# LLM_API_KEY=

# DeepSeek, direct. Their own API -- a DeepSeek key works here and nowhere else.
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash
# LLM_API_KEY=sk-...

# The same model through OpenRouter, which is a *different* service needing a
# *different* key -- and at the time of writing is cheaper per token than
# DeepSeek direct. Note the vendor prefix in the model id; OpenRouter needs it,
# DeepSeek's own API rejects it.
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-v4-flash-0731
# LLM_API_KEY=sk-or-...

# --- the coach's fallback provider ---
# Used only when the primary refuses with a 429, and only by the coach. A quota
# error is an inconvenience in the dock ("ask again in a minute") and fatal in
# the planner, because a week that will not generate is simply absent -- and the
# free models that plan well are exactly the ones with tight caps.
#
# Deliberately separate from LLM_*, which is the dock's provider: sharing them
# would stop you running a free primary and a paid backstop, which is the point.
#
# Any OpenAI-compatible endpoint. DeepSeek through OpenRouter, which is cheaper
# per token than DeepSeek's own API at the time of writing:
# COACH_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# COACH_FALLBACK_MODEL=deepseek/deepseek-v4-flash-0731
# COACH_FALLBACK_API_KEY=sk-or-...
#
# The same model on DeepSeek's own API instead. Different service, different
# key, and the vendor prefix must come off -- DeepSeek rejects the id OpenRouter
# requires, and the failure reads like a bad key rather than a wrong endpoint:
#COACH_FALLBACK_BASE_URL=https://api.deepseek.com
#COACH_FALLBACK_MODEL=deepseek-v4-flash
#COACH_FALLBACK_API_KEY=sk-...
#
# Leave all three unset and there is no fallback: the coach fails with the
# quota error, as it did before.

# --- storage ---
# LEDGER_DB_PATH=./data/ledger.db
