# Copy to .env and fill in the four paths below. Nothing here is a secret --
# the Hevy API key and the Google token live in the two helper apps' own files.
#
# Multi-value fields split on '||' so Windows paths containing spaces survive,
# e.g. HEALTH_MCP_ARGS=C:\My Files\server\dist\index.js||--verbose

# --- The two helper apps. Use full paths. See the README, Step 3. ---
HEVY_MCP_COMMAND=/path/to/hevy-mcp
HEVY_MCP_ARGS=
HEVY_MCP_ENV=HEVY_DOTENV=/path/to/hevy-mcp/.env

HEALTH_MCP_COMMAND=node
HEALTH_MCP_ARGS=/path/to/google-health-mcp-v1/dist/index.js
HEALTH_MCP_ENV=GOOGLE_HEALTH_TOKEN_PATH=/path/to/token.json

# --- Your timezone, as an offset in minutes. UK summer 60, most of Europe 120,
# --- US Eastern -300. Decides which day a late-evening session counts as.
LOCAL_UTC_OFFSET_MINUTES=120

# --- Optional: only the chat box (ledger ask) and planner (ledger plan) need a
# --- model. Free Gemini key, no card: https://aistudio.google.com/apikey
# --- Everything else works without one. See docs/model-providers.md.
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# --- Optional: how sets are counted. The defaults are sensible; change them
# --- from the dashboard or with `ledger targets`. See docs/how-it-works.md.
# SECONDARY_WEIGHT=0.5
# COUNT_WARMUP_SETS=false
# WEEK_STARTS_ON=0
# REP_RANGE_LOW=6
# REP_RANGE_HIGH=10

# --- Optional: where the database lives. Defaults to ./data/ledger.db
# LEDGER_DB_PATH=

# --- Optional: a second provider the planner falls back to on a rate limit.
# --- All three are required, or it stays off. See docs/model-providers.md.
# COACH_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# COACH_FALLBACK_MODEL=deepseek/deepseek-v4-flash-0731
# COACH_FALLBACK_API_KEY=sk-or-...
