# Copy to .env and fill in. Multi-value fields are split on '||' so that Windows
# paths containing spaces survive.

# --- Hevy MCP (stdio) ---
# The server that holds your Hevy API key. This app never sees the key itself.
HEVY_MCP_COMMAND=/path/to/hevy-mcp
HEVY_MCP_ARGS=
HEVY_MCP_ENV=HEVY_DOTENV=/path/to/hevy-mcp/.env

# --- Google Health MCP (stdio) ---
HEALTH_MCP_COMMAND=node
HEALTH_MCP_ARGS=/path/to/google-health-mcp-server/dist/index.js
HEALTH_MCP_ENV=GOOGLE_HEALTH_TOKEN_PATH=/path/to/token.json

# --- conventions ---
# Weighting applied to sets where a muscle is a secondary mover.
SECONDARY_WEIGHT=0.5
# Whether warmup sets count toward effective volume. Standard practice is no.
COUNT_WARMUP_SETS=false
# Your UTC offset in minutes; decides which day a late-evening session lands on.
LOCAL_UTC_OFFSET_MINUTES=0
# 0 = weeks start Monday.
WEEK_STARTS_ON=0

# --- model layer (optional; only `ledger ask` needs it) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- storage ---
# LEDGER_DB_PATH=./data/ledger.db
